generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
  CASHIER
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum MerchantStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  PURCHASE
  SALE
  RETURN
  DAMAGED
  LOST
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum GatewayType {
  UPI_INTENT
  RAZORPAY
  CASHFREE
  PHONEPE
}

model SuperAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(SUPER_ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Merchant {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  mobile           String         @unique
  name             String
  shopName         String
  category         String
  gstin            String?
  referralCode     String?
  status           MerchantStatus @default(ACTIVE)
  emailVerified    Boolean        @default(false)
  verificationCode String?
  resetToken       String?
  resetTokenExpiry DateTime?

  // Profile & Business Config
  profileImage    String?
  logoUrl         String?
  upiId           String?
  address         String?
  businessHours   String?
  preferredLang   String   @default("English")
  themePreference String   @default("emerald")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-Tenant Relations
  users           MerchantUser[]
  invoices        Invoice[]
  products        Product[]
  inventory       StockMovement[]
  customers       Customer[]
  suppliers       Supplier[]
  qrPosters       QrPoster[]
  aiLogs          AiHistory[]
  campaigns       Campaign[]
  auditLogs       AuditLog[]
  sessions        ActiveSession[]
  settings        MerchantSettings?
  gatewayConfig   PaymentGatewayConfig?
  payments        Payment[]
  refunds         Refund[]

  @@index([email])
  @@index([mobile])
}

model MerchantUser {
  id         String   @id @default(cuid())
  merchantId String
  email      String   @unique
  password   String
  name       String
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantSettings {
  id                   String   @id @default(cuid())
  merchantId           String   @unique
  emailNotifications   Boolean  @default(true)
  lowStockAlerts       Boolean  @default(true)
  invoiceCreatedNotify Boolean  @default(true)
  campaignNotify       Boolean  @default(true)
  autoCloudBackup      Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model ActiveSession {
  id           String   @id @default(cuid())
  merchantId   String
  sessionToken String   @unique
  deviceInfo   String
  ipAddress    String
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  merchantId String
  userEmail  String
  action     String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Customer {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  mobile      String
  whatsapp    String?
  email       String?
  address     String?
  city        String?
  dob         String?
  anniversary String?
  gstin       String?
  isVip       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Product {
  id            String   @id @default(cuid())
  merchantId    String
  name          String
  category      String
  brand         String?
  sku           String
  barcode       String
  hsnCode       String?
  purchasePrice Float
  sellingPrice  Float
  gstPercent    Float    @default(18)
  stockQuantity Int      @default(0)
  minStockLevel Int      @default(5)
  unit          String   @default("Piece")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant  Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([merchantId])
  @@index([sku])
  @@index([barcode])
}

model StockMovement {
  id         String       @id @default(cuid())
  merchantId String
  productId  String
  type       MovementType
  quantity   Int
  reason     String?
  createdAt  DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Supplier {
  id                 String   @id @default(cuid())
  merchantId         String
  name               String
  phone              String
  whatsapp           String?
  email              String?
  address            String?
  outstandingBalance Float    @default(0)
  createdAt          DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Invoice {
  id             String   @id @default(cuid())
  merchantId     String
  invoiceNumber  String
  customerName   String
  customerMobile String?
  totalAmount    Float
  taxAmount      Float
  status         String   @default("PAID")
  pdfUrl         String?
  createdAt      DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model QrPoster {
  id         String   @id @default(cuid())
  merchantId String
  theme      String
  title      String
  upiId      String
  posterUrl  String?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Campaign {
  id         String   @id @default(cuid())
  merchantId String
  title      String
  channel    String
  message    String
  shares     Int      @default(0)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model AiHistory {
  id         String   @id @default(cuid())
  merchantId String
  prompt     String
  response   String
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model PaymentGatewayConfig {
  id                  String   @id @default(cuid())
  merchantId          String   @unique
  razorpayKeyId       String?
  razorpayKeySecret   String?
  cashfreeAppId       String?
  cashfreeSecretKey   String?
  phonepeClientId     String?
  phonepeClientSecret String?
  merchantVpa         String?
  updatedAt           DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(cuid())
  merchantId     String
  orderId        String        @unique
  gateway        GatewayType
  gatewayOrderId String?
  transactionId  String?
  amount         Float
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  customerName   String?
  customerMobile String?
  invoiceId      String?
  signature      String?
  rawWebhookData String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  refunds  Refund[]

  @@index([merchantId])
  @@index([orderId])
  @@index([transactionId])
}

model Refund {
  id              String   @id @default(cuid())
  merchantId      String
  paymentId       String
  gatewayRefundId String   @unique
  amount          Float
  reason          String?
  status          String   @default("PROCESSED")
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}
